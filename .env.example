# --- Usados por check-all-users.js (el chequeo periódico multiusuario) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
CREDENTIALS_ENCRYPTION_KEY=
TELEGRAM_TOKEN=

# Opcional. Tu chat_id de Telegram (ej. hablándole a @userinfobot). Si lo
# pones, el bot te avisa por Telegram cuando INTRALU se cae y cuando se
# recupera — sin esto, esos avisos solo quedan en los logs de GitHub Actions.
ADMIN_CHAT_ID=

# --- Opcional: solo para tu propio diagnóstico local ---
# login-test.js, fichas-test.js y explorar-test.js
UNI_CODIGO=tu_codigo_uni
UNI_PASSWORD=tu_contraseña

# --- Usados por fetch-fichas.js y fetch-historial.js corridos a mano ---
# En GitHub Actions los inyecta el workflow desde los inputs; localmente los
# pones acá para probar (CHAT_ID es a quién le llega el resultado).
CHAT_ID=
FICHA_ID=ficha-academica-pdf
CODPER=20261

# --- Personal Access Token de GitHub (NO lo usa ningún script de este repo) ---
#
# Está acá solo para tenerlo a mano al rotarlo. El mismo valor va cargado en
# DOS lugares, y si actualizas uno solo, la mitad del bot se rompe en
# silencio hasta que alguien mira los logs:
#
#   1. GitHub → repo → Settings → Secrets and variables → Actions
#      Nombre: WORKFLOW_DISPATCH_TOKEN
#      Sin esto, check-grade.yml no encadena la siguiente corrida y el
#      chequeo de notas queda a merced del cron de respaldo (falla visible:
#      el paso "Encadenar la siguiente corrida" da 401 Bad credentials).
#
#   2. Supabase → Edge Functions → Secrets
#      Nombre: GITHUB_DISPATCH_TOKEN
#      Sin esto, /fichas y /ciclos no disparan su workflow (el bot ahora te
#      avisa "No pude arrancar la consulta (GitHub respondió 401)").
#
# Permisos que necesita: fine-grained token con acceso a este repositorio y
# "Actions: Read and write". Ojo con la expiración: por defecto son 30 días,
# y cuando vence se rompen los dos usos de arriba a la vez.
#
# Comando para actualizar el de GitHub sin que el valor pase por pantalla:
#   $v = ((Get-Content .env | Where-Object { $_ -match '^GITHUB_DISPATCH_TOKEN=' }) -replace '^GITHUB_DISPATCH_TOKEN=','').Trim()
#   $v | gh secret set WORKFLOW_DISPATCH_TOKEN
GITHUB_DISPATCH_TOKEN=
